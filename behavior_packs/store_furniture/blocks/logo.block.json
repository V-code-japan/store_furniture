{
  "format_version": "1.26.32",
  "minecraft:block": {
    "description": {
      "identifier": "edu:logo",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        },
        "minecraft:connection": {
          "enabled_states": ["minecraft:cardinal_connections"]
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "origin": [-8, 0, 7],
        "size": [16, 16, 1]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, 7],
        "size": [16, 16, 1]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.65
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 15
      },
      "minecraft:geometry": "geometry.logo_small",
      "minecraft:material_instances": {
        "*": {
          "texture": "logo_small",
          "render_method": "alpha_test"
        }
      },
      "minecraft:light_emission": 10,
      "minecraft:map_color": "#5f4a2b"
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 180, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 0, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 90, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [0, 270, 0]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && q.block_state('minecraft:connection_west')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_left",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && q.block_state('minecraft:connection_east')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_left",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && q.block_state('minecraft:connection_north')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_left",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && q.block_state('minecraft:connection_south')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_left",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north' && q.block_state('minecraft:connection_east')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_right",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south' && q.block_state('minecraft:connection_west')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_right",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east' && q.block_state('minecraft:connection_south')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_right",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west' && q.block_state('minecraft:connection_north')",
        "components": {
          "minecraft:geometry": "geometry.logo_large_right",
          "minecraft:material_instances": {
            "*": {
              "texture": "logo_large",
              "render_method": "alpha_test"
            }
          }
        }
      }
    ]
  }
}
